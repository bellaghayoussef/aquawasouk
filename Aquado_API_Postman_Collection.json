                    "name": "Update Cart Item",
                    "request": {
                        "method": "PUT",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"quantity\": 3\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/cart/update/:cartItemId",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "cart",
                                "update",
                                ":cartItemId"
                            ],
                            "variable": [
                                {
                                    "key": "cartItemId",
                                    "value": "1"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Remove from Cart",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/cart/remove/:cartItemId",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "cart",
                                "remove",
                                ":cartItemId"
                            ],
                            "variable": [
                                {
                                    "key": "cartItemId",
                                    "value": "1"
                                }
                            ]
                        }
                    }
                }
            ]
        },
